    "exercise_detail_insight_next_flat" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latest session volume and top weight are similar to the previous time. Adjust load or reps based on how you felt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直近のセッションは前回と総負荷・重量がほぼ同水準です。体感に合わせて重量や回数を微調整しましょう。"
          }
        }
      }
    },
    "exercise_detail_insight_next_flat_cardio" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance and time are similar to last time. Adjust pace or duration as needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離・時間は前回と近いです。ペースや時間を体感に合わせて調整できます。"
          }
        }
      }
    },
    "exercise_detail_insight_next_flat_time" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total time and hold times are close to last time. Tweak duration or intensity by feel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合計時間・最長ホールドは前回と近いです。体感に合わせて秒数や強度を調整できます。"
          }
        }
      }
    },
    "exercise_detail_insight_next_mixed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signals are mixed. Review the chart and last sets to decide whether to hold or progress."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "増減が混在しています。グラフと直近セットを見て、維持か進めるか判断しましょう。"
          }
        }
      }
    },
    "exercise_detail_insight_next_progress" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume and/or weight are trending up. Keep form first, then add load or reps gradually."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負荷や重量が伸びています。フォームを優先し、無理のない範囲で負荷アップを検討できます。"
          }
        }
      }
    },
    "exercise_detail_insight_next_progress_cardio" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance or duration improved. Progress gradually while monitoring heart rate and form."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離や時間が伸びています。心拍とフォームを見ながら無理なく進めましょう。"
          }
        }
      }
    },
    "exercise_detail_insight_next_progress_time" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time held or total duration improved. Build up gradually if it felt sustainable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間が伸びています。無理なく続けられる範囲で段階的に伸ばしましょう。"
          }
        }
      }
    },
    "exercise_detail_insight_next_recovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume or top weight dipped compared to last time. Prioritize recovery, sleep, and technique before pushing harder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回より負荷や重量が落ちています。回復・睡眠・フォームを整えてから追い込みを。"
          }
        }
      }
    },
    "exercise_detail_insight_next_recovery_cardio" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metrics are down from last time. Consider recovery and consistency before pushing harder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回より数値が落ちています。回復と継続を優先してから負荷を上げましょう。"
          }
        }
      }
    },
    "exercise_detail_insight_next_recovery_time" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time metrics dropped from last time. Check fatigue and form before adding difficulty."
